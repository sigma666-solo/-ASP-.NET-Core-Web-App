@model Cat

<h1 class="mb-4">Редактирование котика</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label class="control-label" asp-for="Name">Имя: </label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label" asp-for="Age">Возраст: </label>
        <input asp-for="Age" type="number" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label" asp-for="Color">Цвет: </label>
        <input asp-for="Color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label" asp-for="Description">Описание: </label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label" asp-for="UrlPhoto">Ссылка на фотографию: </label>
        <input asp-for="UrlPhoto" class="form-control" />
        <span asp-validation-for="UrlPhoto" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>
